# Server
PORT=5001

# Database
DB_HOST=127.0.0.1
DB_NAME=face_recog
DB_USER=attendance_app
DB_PASSWORD=your_mysql_password
DB_PORT=3306
DB_SSL=false
# DB_SSL_CA=
# CORS_ORIGINS=https://your-frontend.vercel.app

# Authentication
JWT_SECRET=your_jwt_secret_here

# Default Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

# Biometrics (generate a separate key with: openssl rand -hex 32)
BIOMETRIC_ENCRYPTION_KEY=
BIOMETRIC_RETENTION_DAYS=180

# Attendance reports
ATTENDANCE_TARGET_PERCENT=75

# Set this on Vercel for the daily retention job
# CRON_SECRET=
